{
  "name": "notion-timer",
  "productName": "Time Tracker for Notion",
  "version": "1.0.0",
  "description": "Floating time-tracking widget that creates and manages time registrations in Notion",
  "author": "Wim Vandonck",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "icons": "node scripts/generate-icons.cjs",
    "test": "node --test \"src/**/*.test.js\" \"electron/**/*.test.cjs\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "dist": "npm run build && electron-builder --win",
    "dist:dev": "npm run build && electron-builder --win --config electron-builder.dev.cjs",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/react-icons": "^2.0.330",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "wait-on": "^9.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.wimvandonck.notiontimer",
    "productName": "Time Tracker for Notion",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json",
      "!electron/**/*.test.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false
  }
}
